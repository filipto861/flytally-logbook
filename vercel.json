{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "fra1"
  ],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "test/sp2-browser-preview": true
    }
  },
  "ignoreCommand": "node tooling/vercel-ignore-build.mjs",
  "crons": [
    {
      "path": "/api/cron/backups",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/cron/recency",
      "schedule": "15 5 * * *"
    }
  ]
}
