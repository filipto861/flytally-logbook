{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "fra1"
  ],
  "ignoreCommand": "node tooling/vercel-ignore-build.mjs",
  "crons": [
    {
      "path": "/api/cron/backups",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/cron/recency",
      "schedule": "15 5 * * *"
    }
  ]
}
