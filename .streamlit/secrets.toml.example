# This file is an example only. Do NOT commit real secrets.
# In Streamlit Community Cloud, put these values in App settings -> Secrets.

[auth]
admin_password = "CHANGE_ME_TO_A_STRONG_PASSWORD"
allow_registration = false

# SQLite-only legacy backup. It is automatically disabled while PostgreSQL is production.
# Create a GitHub fine-grained token with Contents: Read and write permission for this repository.
[github]
token = "github_pat_xxx"
repo = "filipto861/Logbook"
db_path = "data/logbook.sqlite"
branch = "main"
auto_backup = true

# PostgreSQL connection. Never commit a real DSN/password to GitHub.
# PostgreSQL production example. Never commit a real DSN/password.
[database]
postgres_dsn = "postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
postgres_pool_min = 0
postgres_pool_max = 4
postgres_connect_timeout = 5

# Normal production state after v0.72 cutover:
production_backend = "postgresql"
cutover_confirm = "POSTGRESQL_PRODUCTION"

# Emergency manual fallback only. SQLite may be stale after PostgreSQL writes.
# To deliberately fall back while cutover_confirm is still present:
# production_backend = "sqlite"
# fallback_confirm = "SQLITE_EMERGENCY_FALLBACK"
