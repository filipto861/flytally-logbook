# This file is an example only. Do NOT commit real secrets.
# In Streamlit Community Cloud, put these values in App settings -> Secrets.

[auth]
admin_password = "CHANGE_ME_TO_A_STRONG_PASSWORD"
allow_registration = false

# Enables automatic backup of data/logbook.sqlite back to GitHub after every confirmed write.
# Create a GitHub fine-grained token with Contents: Read and write permission for this repository.
[github]
token = "github_pat_xxx"
repo = "filipto861/Logbook"
db_path = "data/logbook.sqlite"
branch = "main"
auto_backup = true

# v0.70 PostgreSQL target/diagnostics only. This does NOT switch the app runtime.
# Use an SSL-required managed PostgreSQL connection string in production.
[database]
postgres_dsn = "postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
postgres_pool_min = 0
postgres_pool_max = 4
postgres_connect_timeout = 5
