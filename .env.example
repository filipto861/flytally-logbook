# Pooled Neon connection string. Keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Generate at least 32 random bytes, e.g. `openssl rand -base64 48`.
SESSION_SECRET=replace-with-a-long-random-secret

# Shared only with trusted FlyTally products for domain-separated short-lived identity and privacy-erasure assertions.
# Use a different secret from SESSION_SECRET.
FLYTALLY_IDENTITY_SECRET=replace-with-a-different-long-random-secret

# Canonical FlyTally Training origin, e.g. https://training.fly-tally.com
TRAINING_APP_URL=

# ArcGIS server-side credential for satellite Story tiles.
ARCGIS_ACCESS_TOKEN=

# Public legal/operator identity. These values are rendered on legal pages.
# Fill all of them before a public commercial launch.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_ID=
LEGAL_CONTACT_EMAIL=support@fly-tally.com

# v2.9 commercial launch state. Defaults/fails closed to private-beta.
# Allowed: private-beta | external-validation | commercial
FLYTALLY_LAUNCH_STAGE=private-beta

# External validation ledger. Missing/unknown values remain PENDING.
# Approval-required gates accept APPROVED only.
COMMERCIAL_LEGAL_REVIEW_STATUS=PENDING
COMMERCIAL_CONSUMER_LAW_ADR_STATUS=PENDING
COMMERCIAL_PRIVACY_PROCESSOR_STATUS=PENDING
COMMERCIAL_TRAINING_SOURCE_RIGHTS_STATUS=PENDING
COMMERCIAL_SUPPORT_OPERATIONS_STATUS=PENDING
COMMERCIAL_POLICIES_STATUS=PENDING
COMMERCIAL_TERMS_PUBLISHED_STATUS=PENDING

# Decision-required gates accept APPROVED or NOT_REQUIRED after an explicit review.
COMMERCIAL_BILLING_STATUS=PENDING
COMMERCIAL_QES_STATUS=PENDING
COMMERCIAL_AVIATION_VALIDATION_STATUS=PENDING
COMMERCIAL_TRADEMARK_STATUS=PENDING
COMMERCIAL_MARKETING_CLAIMS_STATUS=PENDING


# C2 commercial legal bundle publication chain.
# All three versions must match the exact commercial legal content version committed in code.
# Keep blank until the reviewed bundle exists; blank/mismatch fails closed.
COMMERCIAL_LEGAL_BUNDLE_VERSION=
COMMERCIAL_LEGAL_REVIEWED_VERSION=
COMMERCIAL_LEGAL_PUBLISHED_VERSION=


# C4 signature / aviation-regulatory strategy version.
# Set only to the exact strategy version recorded in code after review.
# External evidence remains a code-level release artifact; env flags alone cannot open commercial mode.
COMMERCIAL_REGULATORY_STRATEGY_VERSION=


# C5 brand / public-claims policy version.
# Set only to the exact policy version recorded in code after the trademark/brand and claims review.
# External evidence remains a code-level release artifact; env flags alone cannot open commercial mode.
COMMERCIAL_BRAND_CLAIMS_POLICY_VERSION=
